# Let logged-in users access the RK S85 without root.
# The number must stay below 73: systemd applies uaccess ACLs in 73-seat-late.rules,
# so a uaccess tag added by a later file (e.g. 99-*) has no effect.
# Install: sudo cp 70-rk-s85.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="01fa", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="0193", TAG+="uaccess"
